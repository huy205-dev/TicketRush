# TicketRush configuration (SPEC.md section 11).
#
# `make .env` (run automatically by `make run-*`) copies this file to .env and
# fills every *_SECRET with a random value. Never commit .env.
#
# Commented-out variables show their default. Leave them commented to use the
# default and to be able to override them per run, e.g. `HOLD_TTL=2s make run-booking`
# (anything set in .env wins over the shell environment).

# dev | prod. dev-login is only enabled in dev.
APP_ENV=dev

# Required. Matches the postgres service in deploy/compose.yaml.
DATABASE_URL=postgres://ticketrush:ticketrush@localhost:5432/ticketrush?sslmode=disable
# DB_MAX_CONNS=20

# REDIS_ADDR=localhost:6379
# Comma-separated.
# KAFKA_BROKERS=localhost:19092

# redis | pg. pg is the PostgreSQL-only baseline kept for comparison (ADR-000).
# INVENTORY_BACKEND=redis

# Go durations: 10m, 30s, 2s...
# HOLD_TTL=10m
# HOLD_GRACE=30s
# ADMISSION_TTL=5m
# ADMIT_INTERVAL=1s
# ADMIT_BATCH=200
# How often the expiry worker looks for HELD orders past their deadline.
# EXPIRY_INTERVAL=5s

# Default true. Set to false to load-test booking without the waiting room.
# Must stay false until the waiting room exists (M5).
REQUIRE_ADMISSION=false

# Required, at least 32 characters, all four different.
# Generate one with: openssl rand -hex 32
JWT_SECRET=
ADMISSION_SECRET=
WEBHOOK_SECRET=
TICKET_SECRET=

# Where booking reaches fakepay, and where fakepay's payment pages live.
# FAKEPAY_URL=http://localhost:8090
# Booking's own address; fakepay sends webhooks to PUBLIC_BASE_URL/v1/webhooks/fakepay.
# PUBLIC_BASE_URL=http://localhost:8080

# Fake payment gateway faults (cmd/fakepay, SPEC.md 7.3). Rates are 0..1.
# Random delay before each webhook:
# FAKEPAY_DELAY_MS_MIN=100
# FAKEPAY_DELAY_MS_MAX=2000
# Chance of sending 1-3 extra copies of a webhook:
# FAKEPAY_DUPLICATE_RATE=0.2
# Chance of a webhook arriving FAKEPAY_LATE_EXTRA_MS later (11 minutes):
# FAKEPAY_LATE_RATE=0.05
# FAKEPAY_LATE_EXTRA_MS=660000
# Chance of treating an accepted webhook as failed and sending it again:
# FAKEPAY_5XX_RATE=0.1

# Empty disables tracing.
# OTEL_EXPORTER_OTLP_ENDPOINT=

# Both empty: notifier only logs. Set both to send Telegram messages.
# TELEGRAM_BOT_TOKEN=
# TELEGRAM_CHAT_ID=
